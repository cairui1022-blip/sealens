<svg width="128" height="128" viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background with gradient border -->
  <rect width="128" height="128" rx="20" fill="url(#bgGradient)"/>
  <rect x="2" y="2" width="124" height="124" rx="18" fill="#0a0118"/>

  <!-- Text "eP" with gradient -->
  <text x="64" y="85" font-family="Inter, system-ui, sans-serif" font-size="60" font-weight="700" text-anchor="middle" fill="url(#textGradient)">
    eP
  </text>

  <!-- Gradients -->
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#7c3aed;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ec4899;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="textGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#a78bfa;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f0abfc;stop-opacity:1" />
    </linearGradient>
  </defs>
</svg>
